    <string name="faq_scan_q">כיצד אוכל לסרוק קוד QR או ברקוד?</string>
    <string name="faq_scan_a">פתח את הכרטיסייה סריקה וכוון את המצלמה אל הקוד שבתוך המסגרת. זה יזוהה ויפענח אוטומטית.</string>
    <string name="faq_create_q">איך אני יוצר קוד QR משלי?</string>
    <string name="faq_create_a">עבור ללשונית צור, בחר סוג (טקסט, כתובת אתר, WiFi, איש קשר וכו\'), מלא את הפרטים והקש על צור.</string>
    <string name="faq_customize_q">האם אוכל להתאים אישית את המראה של קוד ה-QR שלי?</string>
    <string name="faq_customize_a">כֵּן. לאחר יצירת קוד QR, הקש על המשך עריכה כדי לשנות צבעים, צורות פיקסל/פינה/כדור, להוסיף לוגו או להחיל תבנית מוכנה.</string>
    <string name="faq_gallery_q">האם אני יכול לסרוק קוד QR מתמונה במקום מהמצלמה?</string>
    <string name="faq_gallery_a">כֵּן. במסך הסריקה, הקש על לחצן הגלריה ובחר תמונה המכילה קוד QR או ברקוד.</string>
    <string name="faq_history_q">היכן אוכל למצוא את הסריקות הקודמות שלי והקודים שנוצרו?</string>
    <string name="faq_history_a">כל סריקה ויצירה נשמרות אוטומטית בלשונית היסטוריה, מקובצת לפי היום, אתמול, השבוע וישן יותר.</string>
    <string name="faq_favorite_q">כיצד אוכל לשמור קוד QR כמועדף?</string>
    <string name="faq_favorite_a">הקש על סמל הכוכב על כל פריט בהיסטוריה, או במסך התוצאות שלו, כדי להוסיף אותו למועדפים לגישה מהירה מאוחר יותר.</string>
    <string name="faq_permission_q">מדוע האפליקציה זקוקה להרשאת מצלמה?</string>
    <string name="faq_permission_a">נדרשת גישה למצלמה כדי לסרוק קודי QR וברקודים. האפליקציה לא משתמשת במצלמה לשום דבר אחר.</string>
