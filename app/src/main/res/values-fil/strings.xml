    <string name="intro_title_1">I-scan ang anumang QR kaagad</string>
    <string name="intro_content_1">Itutok ang iyong camera para i-decode ang mga QR code nang mabilis at ligtas.</string>
    <string name="intro_title_2">Gumawa ng sariling QR code</string>
    <string name="intro_content_2">Gumawa ng custom na QR code para sa mga link, WiFi, business card, at iba pa.</string>
    <string name="intro_title_3">I-edit at I-customize</string>
    <string name="intro_content_3">Madaling i-update o i-personalize ang iyong mga QR code gamit ang mga kulay at label.</string>
